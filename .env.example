# Python executable from the prepared environment.
PYTHON=python

# CUDA device visible to a single-process run.
GPU_ID=0

# Local model and tokenizer paths. Model identifiers work only when online mode is enabled or cached.
BASE_MODEL=/path/to/base/model
TOKENIZER=/path/to/base/model
ORIGINAL_CLEAN_MODEL=/path/to/base/model
ORIGINAL_CLEAN_TOKENIZER=/path/to/base/model

# Standard cache locations; customize without editing tracked scripts.
HF_HOME=${HOME}/.cache/huggingface
MODELSCOPE_CACHE_DIR=${HOME}/.cache/modelscope

# The public runners are offline-first.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ANTI_HERETIC_MODEL_LOCAL_FILES_ONLY=1

# Optional output roots. Defaults remain inside the repository and are gitignored.
SUITE_RESULTS_DIR=experiments/sidechannel_suite/results
MODEL_SAVE_DIR=experiments/sidechannel_suite/results/models
LOG_DIR=experiments/sidechannel_suite/logs
